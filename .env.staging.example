# Environment variables for the STAGING stack — a fully separate set of
# credentials from .env.docker (production). Copy to .env.staging on the
# VM, inside ~/FinanceDashboard-staging, and fill in real values.
#
# Nothing here should ever point at the same resource as production:
# different Postgres password (→ different data), different R2 bucket
# (→ different files), different domain. That separation is the entire
# point of staging existing at all.

# === IBKR Flex API ===
# Fine to reuse your own real IBKR credentials here (same account, no
# separate "test" IBKR account exists) — this is your own data, not a
# friend's, so the risk profile is different from the rest of this file.
# Leave blank if you don't need to test IBKR-touching features this round.
IBKR_QUERY_ID=<your-flex-query-id>
IBKR_FLEX_WEB_SERVICE_TOKEN=<your-flex-api-token>

# === LLM Providers ===
# Also fine to reuse your real keys — free tier usage from testing is
# negligible. Leave blank to skip AI-categorization testing entirely.
GEMINI_API_KEY=<your-gemini-api-key>
MISTRAL_API_KEY=<your-mistral-api-key>

# === Application Configuration ===
TZ=UTC
TAX_REGIME=RESIDENT
LOG_LEVEL=DEBUG

# === FastAPI Settings ===
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PORT=8000

# === Domain ===
# Doesn't need to resolve anywhere for staging to work — Caddyfile.staging
# uses `tls internal` (self-signed), not Let's Encrypt, so no real DNS
# validation ever happens. A DuckDNS name here is just for a memorable
# URL; https://<vm-ip>:8443 works identically without one.
PUBLIC_DOMAIN=staging-gabrielfinance.duckdns.org

# === Basic auth ===
# Same mechanism as production (see .env.docker.example) — fine to reuse
# the same username/password here, or pick different ones for staging.
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password-here'
BASIC_AUTH_USER=<your-username>
BASIC_AUTH_PASSWORD_HASH=<bcrypt-hash-from-caddy-hash-password>

# === Postgres ===
# MUST be a different password from production's — this is what actually
# keeps the two databases (and their Docker volumes) from ever being the
# same one. Generate with `openssl rand -hex 24`, same as production.
POSTGRES_DB=finance_staging
POSTGRES_USER=finance_staging
POSTGRES_PASSWORD=<generate-a-different-strong-random-password>

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# === Cloudflare R2 ===
# A SEPARATE bucket, not just a different prefix in the production one —
# see docs/app-stack/ notes on why: a staging cleanup script targeting the
# wrong bucket is a much scarier failure mode than targeting the wrong
# prefix in a shared one. Create this bucket once in the Cloudflare
# dashboard before first use.
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<a-separate-r2-access-key-id-for-staging>
R2_SECRET_ACCESS_KEY=<a-separate-r2-secret-access-key-for-staging>
R2_BUCKET_NAME=finance-dashboard-staging
R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.eu.r2.cloudflarestorage.com

# === Clerk (see trades.api.auth and docs/server-setup/clerk-authentication.md) ===
# Publishable key: not a secret — same value as web/.env.local's VITE_CLERK_PUBLISHABLE_KEY.
# Only used at build time, to bake it into the frontend — the backend itself doesn't read it.
CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
# Secret key: a REAL credential. Same Clerk application as production's is fine to reuse here
# (unlike R2, above) — a session token is a session token regardless of which environment it's
# verified from; the risk R2's separate-bucket rule guards against doesn't apply the same way.
CLERK_SECRET_KEY=<your-clerk-secret-key>
# Webhook signing secret: a REAL credential. Staging needs its OWN webhook endpoint configured
# in the Clerk dashboard (its own URL, https://<staging-domain>/api/webhooks/clerk) — Svix signs
# each endpoint's deliveries with a distinct secret, so production's value won't verify here.
CLERK_WEBHOOK_SIGNING_SECRET=<your-staging-clerk-webhook-signing-secret>
