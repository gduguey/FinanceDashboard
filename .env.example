# Environment variables for Docker production deployment
# Copy to .env.docker and fill in your actual values

# === Application Configuration ===
# Timezone for transaction dates (don't change unless you know what you're doing)
TZ=UTC

# Tax regime: NRA (non-resident alien) or RESIDENT
# Affects capital gains tax calculations
TAX_REGIME=RESIDENT

# === Logging ===
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# === FastAPI Settings ===
# Already set in Dockerfile, but can override if needed
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# === Port (should match docker-compose.yml) ===
# FastAPI will run on this port inside the container
PORT=8000

# === Domain (used by the Caddy reverse proxy for TLS) ===
# Your DuckDNS hostname(s) or real domain(s) — no "https://" prefix, Caddy
# assumes HTTPS by default. Caddy auto-issues/renews a Let's Encrypt cert for
# whatever you put here.
# For multiple domains all pointing at this same app, space-separate them — Caddy gets a separate cert for each and
# matches on whichever one the visitor used:
PUBLIC_DOMAIN=gabrielfinance.duckdns.org lottalaplusbelle.duckdns.org

# === Postgres ===
# Used by both the postgres container and the app's DATABASE_URL below.
# Pick a strong random password (e.g. `openssl rand -hex 24`) — this is a
# real credential, keep it only in this file, never in git.
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=<generate-a-strong-random-password>

# Host is "postgres" — that's the service name in docker-compose.yml, which
# Docker's internal DNS resolves to the postgres container. Not a public host.
# This is the migration-owning superuser role (Alembic always connects as this
# one) — never the role the running app itself should serve requests through.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# === Restricted app-runtime role (makes Row-Level Security actually apply) ===
# Postgres superusers (POSTGRES_USER above becomes one) and table owners always
# bypass Row-Level Security, no policy can override that — so the app's own
# request traffic has to connect as a different, ordinary role for the
# `user_isolation` policies (see migration 817ace9deb09) to mean anything.
# REQUIRED, not optional: migrations now run automatically on every container
# start (see the Dockerfile's CMD) and refuse to proceed at all if this isn't
# set — RLS existing but silently not applying is exactly the failure mode
# this is meant to prevent, so a missing value fails the deploy loudly instead.
# Pick a strong random password yourself (same as POSTGRES_PASSWORD above) —
# the migration reads it straight out of this URL and creates/updates the
# `app_runtime` role to match, automatically. No generated-password-to-copy-
# by-hand step: whatever you put here is what the role's password becomes.
DATABASE_URL_APP=postgresql+psycopg://app_runtime:<generate-a-strong-random-password>@postgres:5432/finance

# === Secrets encryption (Fernet) ===
# Fernet encryption key for encrypting secrets in the database. Must be 32
# url-safe base64-encoded bytes. Generated with
# cryptography.fernet.Fernet.generate_key(). Rotate this key periodically,
# and update the version number below. The app will still be able to
# decrypt secrets encrypted with older keys, but new secrets will be
# encrypted with the latest key.
# Generate one on this Mac (or anywhere with the repo's deps installed):
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRETS_ENCRYPTION_KEY=<generate-with-the-command-above>
APP_SECRETS_ENCRYPTION_KEY_VERSION=1

# Rotating from version 1 to version 2, once you're ready to retire the key above:
#   1. Generate a new key the same way (the command above), on this Mac.
#   2. Move the CURRENT key/version (the ones above) into
#      APP_SECRETS_ENCRYPTION_KEYS_PREVIOUS below, as a JSON object mapping
#      key_version (as a string) -> key:
#        APP_SECRETS_ENCRYPTION_KEYS_PREVIOUS={"1":"<the-version-1-key-you-just-moved-out>"}
#   3. Set APP_SECRETS_ENCRYPTION_KEY to the newly generated key, and bump
#      APP_SECRETS_ENCRYPTION_KEY_VERSION to 2.
#   4. Commit/deploy as usual (`./deploy.sh ...`, or `docker compose up -d`
#      if editing `.env.docker` directly on the VM) — no migration needed,
#      `db.encryption` reads these three vars directly. Existing rows still
#      decrypt fine via key_version 1 in APP_SECRETS_ENCRYPTION_KEYS_PREVIOUS;
#      every new secret encrypts under version 2. Rows aren't automatically
#      re-encrypted — only delete a version from
#      APP_SECRETS_ENCRYPTION_KEYS_PREVIOUS once nothing still references it.
# APP_SECRETS_ENCRYPTION_KEYS_PREVIOUS={"1":"<previous-key-here>"}

# === Cloudflare R2 (S3-compatible) — for storing statement files ===
# Get these from the Cloudflare dashboard: R2 > Manage API Tokens > Create API Token
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=finance-dashboard-data
R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.eu.r2.cloudflarestorage.com

# === Clerk (see trades.api.auth and docs/server-setup/clerk-authentication.md) ===
# Publishable key: not a secret — same value as web/.env.local's VITE_CLERK_PUBLISHABLE_KEY.
# Only used at *build* time here, to bake it into the frontend (see the Dockerfile/docker-compose
# build.args) — the running backend itself doesn't read this one.
CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
# Secret key: a REAL credential — lets its holder act as your Clerk account. From the Clerk
# dashboard's API Keys page. The backend uses this to verify session tokens are genuine.
CLERK_SECRET_KEY=<your-clerk-secret-key>
# Webhook signing secret: a REAL credential, shown once when you create the webhook endpoint
# in the Clerk dashboard (Webhooks > Add Endpoint, URL https://<your-domain>/api/webhooks/clerk,
# subscribed to user.created). Auto-provisions a `users` row the moment someone accepts an
# invite — see trades.api.webhooks and docs/server-setup/clerk-authentication.md.
CLERK_WEBHOOK_SIGNING_SECRET=<your-clerk-webhook-signing-secret>
