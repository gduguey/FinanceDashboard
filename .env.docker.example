# Environment variables for Docker production deployment
# Copy to .env.docker and fill in your actual values

# === IBKR Flex API (for syncing portfolio data) ===
# Get from IBKR Flex Web Service: https://ibkr.com/account/settings/flex-queries
IBKR_FLEX_QUERY_ID=<your-flex-query-id>
IBKR_FLEX_API_TOKEN=<your-flex-api-token>

# === LLM Providers (for AI transaction categorization) ===
# Get from https://ai.google.dev/ (free tier available)
GOOGLE_GENAI_API_KEY=<your-gemini-api-key>

# Optional: Mistral fallback provider
# Get from https://console.mistral.ai/
MISTRAL_API_KEY=<your-mistral-api-key>

# === Application Configuration ===
# Timezone for transaction dates (don't change unless you know what you're doing)
TZ=UTC

# Tax regime: NRA (non-resident alien) or RESIDENT
# Affects capital gains tax calculations
TAX_REGIME=RESIDENT

# === Logging ===
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# === FastAPI Settings ===
# Already set in Dockerfile, but can override if needed
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# === Port (should match docker-compose.yml) ===
# FastAPI will run on this port inside the container
PORT=8000

# === Domain (used by the Caddy reverse proxy for TLS) ===
# Your DuckDNS hostname (e.g. yourapp.duckdns.org) or real domain.
# Caddy auto-issues/renews a Let's Encrypt cert for whatever you put here.
PUBLIC_DOMAIN=<yourapp.duckdns.org>

# === Postgres ===
# Used by both the postgres container and the app's DATABASE_URL below.
# Pick a strong random password (e.g. `openssl rand -hex 24`) — this is a
# real credential, keep it only in this file, never in git.
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=<generate-a-strong-random-password>

# Host is "postgres" — that's the service name in docker-compose.yml, which
# Docker's internal DNS resolves to the postgres container. Not a public host.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# === Cloudflare R2 (S3-compatible) — for storing statement files ===
# Get these from the Cloudflare dashboard: R2 > Manage API Tokens > Create API Token
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=finance-dashboard-statements
R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
