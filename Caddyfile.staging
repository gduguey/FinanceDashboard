# `tls internal` — Caddy self-signs a certificate using its own local CA
# instead of requesting a real one from Let's Encrypt. No ACME challenge is
# ever attempted, so this works regardless of port (8443 here, not 443) and
# needs no DNS validation at all. Your browser will show a "not trusted"
# warning the first time — expected and fine, since you're the only person
# who will ever visit this URL. See docs/server-setup/staging.md.
{$PUBLIC_DOMAIN} {
	tls internal
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_PASSWORD_HASH}
	}
	reverse_proxy api:8000
}
